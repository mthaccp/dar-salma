rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls ces identifiants peuvent lire et modifier les données de Dar Salma.
    // Un identifiant « ghazi » correspond à « ghazi@darsalma.local » dans Firebase.
    function autorise() {
      return request.auth != null && request.auth.token.email in [
        'ghazi@darsalma.local',
        'salma@darsalma.local'
      ];
    }
    match /{document=**} {
      allow read, write: if autorise();
    }
  }
}
